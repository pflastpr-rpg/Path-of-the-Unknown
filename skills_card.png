  <!-- Left page — rune content -->
  <!-- Title line -->
  <rect x="212" y="164" width="90" height="3" rx="1" fill="#A81818" opacity="0.9" style="fill:rgb(168, 24, 24);stroke:none;color:rgb(0, 0, 0);stroke-width:1px;stroke-linecap:butt;stroke-linejoin:miter;opacity:0.9;font-family:&quot;Anthropic Sans&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif;font-size:16px;font-weight:400;text-anchor:start;dominant-baseline:auto"/>
